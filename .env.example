# Copie para .env (ou rode `npm run setup`, que já gera o JWT_SECRET e a ADMIN_KEY para você).
# NUNCA versione o .env: ele contém segredos.

NODE_ENV=development
PORT=3000

# MongoDB local (docker compose up -d mongo) ...
MONGO_URL=mongodb://127.0.0.1:27017/petmais
# ... ou MongoDB Atlas (troque USUARIO/SENHA; se a URL não trouxer o banco, usamos MONGO_DB):
# MONGO_URL=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?appName=PetMais
# MONGO_DB=petmais

# OBRIGATÓRIO: 32+ caracteres aleatórios em produção (mínimo 16 em desenvolvimento).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Formato: número + s|m|h|d  (ex.: 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Chave do gerente: libera as rotas /api/admin/* (header X-Admin-Key). Vazia = rotas admin desabilitadas.
ADMIN_KEY=

# Custo do bcrypt (4 a 15). 10 é um bom equilíbrio.
BCRYPT_ROUNDS=10

# Origens permitidas no CORS, separadas por vírgula. '*' libera tudo (ok em dev; o app nativo nem usa CORS).
CORS_ORIGIN=*
# Atrás de proxy/PaaS (Render, Railway...)? Informe quantos proxies: 1
TRUST_PROXY=0
# Limites por IP: geral, login/cadastro e assistente (por janela; veja src/middlewares/limitadores.js)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=20

# ---------- Assistente com IA (Ollama) ----------
# "ollama" = IA real (se o Ollama estiver fora do ar, cai automaticamente para as regras) | "regras" = sem IA
ASSISTANT_PROVIDER=ollama
# O Ollama deve rodar na MESMA máquina do backend. Nunca exponha a porta 11434 na rede (não tem autenticação).
OLLAMA_URL=http://127.0.0.1:11434
# Modelo criado por `npm run ia:treinar`
OLLAMA_MODEL=petmais-assistente
# Em notebook sem GPU, respostas levam de 5 a 40s. Passou do tempo, usa as regras.
OLLAMA_TIMEOUT_MS=45000
# Máximo de perguntas à IA ao mesmo tempo (as excedentes são respondidas pelas regras, sem fila)
OLLAMA_MAX_CONCURRENT=2

# ---------- Só do app (Expo): fica no .env do FRONT, não aqui ----------
# EXPO_PUBLIC_API_URL=http://192.168.1.2:3000

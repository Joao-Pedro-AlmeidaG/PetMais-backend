{
  "name": "petmais-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do PetMais (Node.js + Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeds/seed.js",
    "seed:reset": "node src/seeds/seed.js --reset",
    "test": "node --test \"tests/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "ia:treinar": "node scripts/ia-treinar.mjs",
    "ia:dataset": "node scripts/ia-treinar.mjs --exportar-treino"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "zod": "^3.25.76"
  }
}
